# Supabase > Connect > ORMs > Prisma
# Conexão via pooler (porta 6543), usada pela aplicação
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432), usada pelas migrations
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo"

# Claude Console > API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# true = respostas prontas da pasta src/ia/mocks, sem gastar créditos
IA_MOCK=true

# Modelos (opcional). Para economizar nas tarefas simples: IA_MODELO_RAPIDO=claude-haiku-5-5
# IA_MODELO_DOCUMENTOS=claude-opus-5-5
# IA_MODELO_RAPIDO=claude-opus-5-5
