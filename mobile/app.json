{
  "expo": {
    "name": "Bolso",
    "slug": "bolso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.rodrickcs.bolso",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Bolso usa a câmera para fotografar cupons fiscais e comprovantes.",
          "photosPermission": "O Bolso acessa suas fotos para ler cupons e comprovantes salvos."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "O Bolso usa a câmera para ler o QR Code dos cupons fiscais.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "bolso"
  }
}
